[TEMPLATE]
# Database — Zeabur MariaDB service auto-populates this after linking
DATABASE_URL="mysql://user:password@host:3306/digital_twin_factory"

# Zeabur will set PORT automatically. Fallback for local dev:
PORT=4000

# Frontend URL(s) allowed by CORS — comma-separated if multiple
CORS_ORIGIN="https://your-frontend.zeabur.app"
