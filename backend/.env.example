# Database — Railway MariaDB plugin provides this as MARIADB_URL or DATABASE_URL
DATABASE_URL="mysql://user:password@host:3306/digital_twin_factory"

# Railway will set PORT automatically. Fallback for local dev:
PORT=4000

# Frontend URL(s) allowed by CORS — comma-separated if multiple
# Railway provides RAILWAY_PUBLIC_DOMAIN, or set this manually:
CORS_ORIGIN="https://your-frontend.railway.app"
